generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id   String @id @default(uuid())
  name String
  pets Pet[]
}

model Pet {
  id        String   @id @default(uuid())
  name      String
  species   String
  age       Int?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}
