generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Pet {
  id        Int      @id @default(autoincrement())
  name      String
  species   String
  age       Int?
  createdAt DateTime @default(now())
}
